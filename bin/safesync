#!/usr/bin/env bash
# ==============================================================================
# SafeSync — Folder sync with optional SHA-256 verification for macOS
# ==============================================================================

set -o pipefail

# NOTE (SEC-14): Do NOT add 'set -e' — PIPESTATUS capture and custom error reporting
# require pipelines and pre-flight tests to complete without early shell abort.
VERSION="0.6.0"

show_help() {
  cat << EOF
SafeSync (v${VERSION}) — Verified Media Backup for macOS

DEFAULT BEHAVIOR:
  Smart Incremental Mode is the DEFAULT.
  - Rsync selects files using its normal size and modification-time checks.
  - Newly transferred files are compared with SHA-256 checksums after copying.

USAGE:
  safesync [OPTIONS] <SOURCE_FOLDER> <DESTINATION_FOLDER>

OPTIONS:
  (default)            Smart Incremental Mode. Fast size/time scan + full SHA-256 hash verification
                       of newly transferred files; skipped files are not checksummed.
  -a, --full-audit     Hash source and destination files, then repair content mismatches.
  -q, --quick          Quick-scan mode. Size + timestamp comparison only (skips post-transfer hashing).
  -n, -d, --dry-run    Simulation mode. Does not modify the destination; writes a local report.
  -i, --confirm        Interactive mode. Scans first and prompts [Y/n] before transferring files.
  -p, --prune          Prune / Mirror mode. Deletes files from destination that no longer exist in
                       source (gated behind confirmation to protect against accidental loss).
  -v, --verbose        Verbose mode. Streams per-file logs and displays full transfer report in terminal.
  -b, --bw <LIMIT>     Rsync bandwidth limit (e.g. 120M, 250M, 50M). Default is 120M.
  -m, --max, --full    Remove the rsync bandwidth limit.
  -h, --help           Show this help message and exit.
  -V, --version        Show version number.

EXAMPLES:
  # Routine Smart Backup (Default: checksum compare newly copied files):
  safesync "/Users/<username>/Pictures/Photos Library.photoslibrary" "/Volumes/BackupSSD/Photos Library.photoslibrary"

  # Full content audit and repair:
  safesync -a "/Users/<username>/Pictures/Photos Library.photoslibrary" "/Volumes/BackupSSD/Photos Library.photoslibrary"

  # Quick simulation test (modifies nothing, previews changes):
  safesync -d "/Users/<username>/Pictures/Photos Library.photoslibrary" "/Volumes/BackupSSD/Photos Library.photoslibrary"

  # Interactive confirmation (previews change count and prompts before sync):
  safesync -i "/Users/<username>/Pictures/Photos Library.photoslibrary" "/Volumes/BackupSSD/Photos Library.photoslibrary"

  # Prune / Mirror mode (deletes files from destination removed from source):
  safesync -p "/Users/<username>/Pictures/Photos Library.photoslibrary" "/Volumes/BackupSSD/Photos Library.photoslibrary"

  # Full-speed transfer (< 20 GB) at uncapped SSD speed:
  safesync -m "/Users/<username>/Movies/Trip_Video" "/Volumes/BackupSSD/Trip_Video"

  # Verbose mode with full report printed in terminal:
  safesync -v "/Users/<username>/Pictures/Photos Library.photoslibrary" "/Volumes/BackupSSD/Photos Library.photoslibrary"

EOF
}

# ANSI terminal escapes for Bash output
C_RESET=""
C_BOLD=""
C_DIM=""
C_YELLOW=""
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_YELLOW=$'\033[33m'
fi

# Default settings
MODE="smart"            # Default: smart incremental
DRY_RUN=0
VERBOSE_MODE=0
INTERACTIVE=0
PRUNE=0
BW_LIMIT="120M"
POSITIONAL_ARGS=()

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--full-audit|--scrub|--checksum)
      MODE="full_audit"
      shift
      ;;
    -q|--quick)
      MODE="quick"
      shift
      ;;
    -n|-d|--dry-run|--dryrun)
      DRY_RUN=1
      shift
      ;;
    -i|--confirm|--interactive)
      INTERACTIVE=1
      shift
      ;;
    -p|--prune|--delete)
      PRUNE=1
      shift
      ;;
    -v|--verbose)
      VERBOSE_MODE=1
      shift
      ;;
    -b|--bw|--bandwidth)
      if [[ -z "$2" || "$2" == -* ]]; then
        echo "Error: Option $1 requires an argument (e.g. -b 120M, -b 250M, -b 0)." >&2
        exit 1
      fi
      if [[ ! "$2" =~ ^[0-9]+[KkMmGg]?$ ]]; then
        echo "Error: Invalid bandwidth limit: $2 (expected format: 120M, 250M, 50K, or 0)." >&2
        exit 1
      fi
      BW_LIMIT="$2"
      shift 2
      ;;
    -m|--max|--full|--full-speed)
      BW_LIMIT="0"
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -V|--version)
      echo "SafeSync v${VERSION}"
      exit 0
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      echo "Run 'safesync --help' for usage." >&2
      exit 1
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Validate positional arguments
if [[ ${#POSITIONAL_ARGS[@]} -lt 2 ]]; then
  show_help
  exit 1
fi

SRC_RAW="${POSITIONAL_ARGS[0]}"
DST_RAW="${POSITIONAL_ARGS[1]}"

# Auto-fix trailing slashes so Finder drag-and-drop always works seamlessly
SRC="${SRC_RAW%/}/"
DST="${DST_RAW%/}/"

if [[ ! -d "$SRC" ]]; then
  echo "Error: Source directory does not exist: $SRC" >&2
  exit 1
fi

# Detect rsync engine and version (REC-03)
RSYNC_VERSION_LINE=$(rsync --version 2>/dev/null | head -n 1)
RSYNC_ENGINE="unknown"
if [[ "$RSYNC_VERSION_LINE" =~ openrsync ]]; then
  RSYNC_ENGINE="openrsync (macOS system default)"
elif [[ "$RSYNC_VERSION_LINE" =~ version\ 3\. ]]; then
  RSYNC_ENGINE="GNU rsync 3.x"
elif [[ "$RSYNC_VERSION_LINE" =~ version\ 2\.6 ]]; then
  RSYNC_ENGINE="Apple legacy rsync 2.6.9"
else
  RSYNC_ENGINE="$RSYNC_VERSION_LINE"
fi

# Advisory warning for active Apple Photos app (REC-04 / DEF-11)
if [[ "$SRC" == *".photoslibrary"* ]] && pgrep -x "Photos" >/dev/null 2>&1; then
  echo "=============================================================="
  echo " [!] ADVISORY: Photos.app is currently running."
  echo "     Syncing while Photos.app is open may encounter transient"
  echo "     SQLite database locks or active daemon changes."
  echo "     For optimal backup consistency, consider quitting Photos.app."
  echo "=============================================================="
  echo ""
fi

# Guard against disconnected / unmounted external volumes (DEF-08 & SEC-05)
VOL=""
if [[ "$DST" =~ ^/Volumes/([^/]+) ]]; then
  VOL="/Volumes/${BASH_REMATCH[1]}"
  if ! mount | grep -F -q " on ${VOL} " && ! [[ -L "$VOL" && "$(readlink "$VOL")" == "/" ]]; then
    echo "Error: External volume '$VOL' is not mounted." >&2
    echo "Please connect the drive or check its mount status in Disk Utility." >&2
    exit 1
  fi
  # Verify volume device matches destination directory device (SEC-05)
  if [[ -d "$DST" ]]; then
    DST_DEV=$(stat -f '%d' "$DST" 2>/dev/null || true)
    VOL_DEV=$(stat -f '%d' "$VOL" 2>/dev/null || true)
    if [[ -n "$VOL_DEV" && -n "$DST_DEV" && "$DST_DEV" != "$VOL_DEV" ]]; then
      echo "Error: Destination directory '$DST' is not on expected volume '$VOL'." >&2
      echo "Device mismatch detected ($DST_DEV != $VOL_DEV). Aborting to protect internal drive." >&2
      exit 1
    fi
  fi
fi

# Check if destination folder already exists before creating it (prevents accidental duplicate backups from typos)
if [[ ! -d "$DST" ]]; then
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "=============================================================="
    echo "  [i] NOTICE: Destination folder does not exist on disk:"
    echo "      $DST"
    echo "      Simulating an INITIAL full sync from scratch."
    echo "=============================================================="
    echo ""
  else
    echo -e "${C_YELLOW}${C_BOLD}==============================================================${C_RESET}"
    echo -e "${C_YELLOW}${C_BOLD}  [!] ⚠️  ATTENTION: Destination folder does not exist:${C_RESET}"
    echo -e "${C_YELLOW}      $DST${C_RESET}"
    echo -e "${C_YELLOW}      SafeSync will create this folder and perform an INITIAL backup.${C_RESET}"
    echo -e "${C_YELLOW}      (If you intended an incremental sync, please check path for typos)${C_RESET}"
    echo -e "${C_YELLOW}${C_BOLD}==============================================================${C_RESET}"
    CONFIRM_NEW_DST="n"
    PROMPT_MSG="${C_YELLOW}${C_BOLD} Create destination folder and proceed? [y/N]: ${C_RESET}"
    if [[ -t 0 ]]; then
      read -r -p "$PROMPT_MSG" CONFIRM_NEW_DST
    else
      read -r -p "$PROMPT_MSG" CONFIRM_NEW_DST || CONFIRM_NEW_DST="n"
    fi
    if [[ ! "$CONFIRM_NEW_DST" =~ ^[Yy] ]]; then
      echo -e "${C_YELLOW} [!] Sync cancelled by user. Please verify your destination path.${C_RESET}"
      exit 1
    fi
    echo ""
  fi
fi

# Ensure destination exists (unless dry-run)
if [[ $DRY_RUN -eq 0 ]]; then
  mkdir -p "$DST"
  # Re-verify device ID immediately after directory creation (SEC-05)
  if [[ -n "$VOL" ]]; then
    DST_DEV=$(stat -f '%d' "$DST" 2>/dev/null || true)
    VOL_DEV=$(stat -f '%d' "$VOL" 2>/dev/null || true)
    if [[ -n "$VOL_DEV" && -n "$DST_DEV" && "$DST_DEV" != "$VOL_DEV" ]]; then
      echo "Error: Destination directory '$DST' created outside expected volume '$VOL'." >&2
      exit 1
    fi
  fi
fi

# Build rsync flags (SEC-16: native atomic file staging, no partial dir metadata locks)
RSYNC_FLAGS=("-avvi" "--8-bit-output" "--force")

if [[ "$MODE" == "full_audit" ]]; then
  RSYNC_FLAGS+=("--checksum")
fi

if [[ $DRY_RUN -eq 1 ]]; then
  RSYNC_FLAGS+=("-n")
fi

if [[ "$BW_LIMIT" != "0" && "$BW_LIMIT" != "max" ]]; then
  RSYNC_FLAGS+=("--bwlimit=$BW_LIMIT")
fi

# Handle Prune / Delete mode (REC-01)
if [[ $PRUNE -eq 1 ]]; then
  RSYNC_FLAGS+=("--delete" "--delete-after")
  if [[ $DRY_RUN -eq 0 && $INTERACTIVE -eq 0 ]]; then
    echo "=============================================================="
    echo "  [!] CAUTION: --prune mode will PERMANENTLY DELETE files from:"
    echo "      $DST"
    echo "      that no longer exist in source:"
    echo "      $SRC"
    echo "=============================================================="
    CONFIRM_PRUNE="n"
    if [[ -t 0 ]]; then
      read -r -p " Are you sure you want to proceed with pruning? [y/N]: " CONFIRM_PRUNE
    else
      read -r -p " Are you sure you want to proceed with pruning? [y/N]: " CONFIRM_PRUNE || CONFIRM_PRUNE="n"
    fi
    if [[ ! "$CONFIRM_PRUNE" =~ ^[Yy] ]]; then
      echo "Pruning cancelled by user."
      exit 0
    fi
    echo ""
  fi
fi

# Essential exclusions for macOS systems and Photos libraries
RSYNC_FLAGS+=(
  "--exclude=.DS_Store"
  "--exclude=.safesync-partial"
  "--exclude=*private/com.apple.photolibraryd/caches*"
  "--exclude=*private/com.apple.photoanalysisd/caches*"
  "--exclude=*private/com.apple.mediaanalysisd/caches*"
  "--exclude=*index.spotlightV3*"
  "--exclude=*SpotlightKnowledgeEvents*"
)

# Pre-Flight Storage Space Check (REC-05 / DEF-14)
CHECK_DIR="$DST"
while [[ ! -d "$CHECK_DIR" && "$CHECK_DIR" != "/" && "$CHECK_DIR" != "." ]]; do
  CHECK_DIR="$(dirname "$CHECK_DIR")"
done
DST_FREE_KB=$(df -k "$CHECK_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
DST_FREE_STR="Unknown"
if [[ -n "$DST_FREE_KB" && "$DST_FREE_KB" =~ ^[0-9]+$ ]]; then
  DST_FREE_GB=$(awk "BEGIN {printf \"%.1f\", $DST_FREE_KB / 1048576}")
  DST_FREE_STR="${DST_FREE_GB} GB"
fi

# Interactive Pre-Flight Inspection (-i / --confirm)
if [[ $INTERACTIVE -eq 1 && $DRY_RUN -eq 0 ]]; then
  echo "=============================================================="
  echo "  SafeSync [INTERACTIVE PRE-FLIGHT INSPECTION]"
  echo "  Source:      $SRC"
  echo "  Destination: $DST"
  echo "  Scanning library for changes..."
  echo "=============================================================="

  CLEAN_PREFLIGHT_FLAGS=()
  for flag in "${RSYNC_FLAGS[@]}"; do
    if [[ ! "$flag" =~ ^--bwlimit ]]; then
      CLEAN_PREFLIGHT_FLAGS+=("$flag")
    fi
  done

  PREFLIGHT_ERR_FILE="/tmp/safesync_preflight_err.$$.log"
  PREFLIGHT_RAW=$(rsync "${CLEAN_PREFLIGHT_FLAGS[@]}" -n "$SRC" "$DST" 2>"$PREFLIGHT_ERR_FILE")
  PREFLIGHT_STATUS=$?

  if [[ $PREFLIGHT_STATUS -ne 0 ]]; then
    echo "==============================================================" >&2
    echo "  [!] ERROR: Pre-flight scan failed (rsync exit code $PREFLIGHT_STATUS)." >&2
    if [[ -f "$PREFLIGHT_ERR_FILE" ]]; then
      cat "$PREFLIGHT_ERR_FILE" >&2
      rm -f "$PREFLIGHT_ERR_FILE"
    fi
    echo "==============================================================" >&2
    exit $PREFLIGHT_STATUS
  fi
  rm -f "$PREFLIGHT_ERR_FILE" 2>/dev/null || true

  # SEC-13: Count all item types accurately (files, directories, symlinks)
  NEW_MOD_COUNT=$(echo "$PREFLIGHT_RAW" | grep -E '^[>ch][fdL]' | wc -l | tr -d ' ')
  UNCHANGED_COUNT=$(echo "$PREFLIGHT_RAW" | grep -E '^\.[fdL]' | wc -l | tr -d ' ')
  DELETED_COUNT=$(echo "$PREFLIGHT_RAW" | grep -E '^\*deleting' | wc -l | tr -d ' ')

  if [[ "$NEW_MOD_COUNT" -eq 0 && ($PRUNE -eq 0 || "$DELETED_COUNT" -eq 0) ]]; then
    echo " [✓] All files are already 100% up to date! Nothing to transfer."
    echo "=============================================================="
    exit 0
  fi

  echo " [i] Pre-Flight Inspection Summary:"
  echo "     - Destination available space: $DST_FREE_STR"
  echo "     - Unchanged historical items:  $UNCHANGED_COUNT"
  echo "     - New or modified items:       $NEW_MOD_COUNT"
  if [[ $PRUNE -eq 1 ]]; then
    echo "     - Orphaned items to be pruned: $DELETED_COUNT"
  fi
  if [[ -n "$DST_FREE_KB" && "$DST_FREE_KB" =~ ^[0-9]+$ && "$DST_FREE_KB" -lt 1048576 ]]; then
    echo "     [!] WARNING: Less than 1 GB available on destination volume!"
  fi
  echo "=============================================================="

  CONFIRM_PROMPT=" Proceed with transfer? [Y/n]: "
  if [[ $PRUNE -eq 1 ]]; then
    CONFIRM_PROMPT=" Proceed with transfer and pruning? [Y/n]: "
  fi

  CONFIRM_RESP="y"
  if [[ -t 0 ]]; then
    read -r -p "$CONFIRM_PROMPT" CONFIRM_RESP
  else
    read -r -p "$CONFIRM_PROMPT" CONFIRM_RESP || CONFIRM_RESP="n"
  fi

  if [[ "$CONFIRM_RESP" =~ ^[Nn] ]]; then
    echo ""
    echo " [!] Sync cancelled by user."
    exit 0
  fi
  echo ""
fi

# Display banner
echo -e "${C_DIM}==============================================================${C_RESET}"
if [[ $DRY_RUN -eq 1 ]]; then
  echo -e "  🔍 ${C_BOLD}Starting SafeSync v${VERSION} [DRY-RUN / SIMULATION MODE]${C_RESET}"
elif [[ "$MODE" == "full_audit" ]]; then
  echo -e "  🛡️  ${C_BOLD}Starting SafeSync v${VERSION} [FULL CONTENT AUDIT]${C_RESET}"
elif [[ "$MODE" == "quick" ]]; then
  echo -e "  ⚡ ${C_BOLD}Starting SafeSync v${VERSION} [QUICK-SCAN MODE (Size + Timestamp)]${C_RESET}"
else
  echo -e "  🛡️  ${C_BOLD}Starting SafeSync v${VERSION} [SMART INCREMENTAL]${C_RESET}"
fi
echo -e "${C_DIM}  📁 Source:       $SRC${C_RESET}"
echo -e "${C_DIM}  💾 Destination:  $DST${C_RESET}"
if [[ "$BW_LIMIT" == "0" || "$BW_LIMIT" == "max" ]]; then
  echo -e "${C_DIM}  🚀 Bandwidth:    Full Throttle (Uncapped)${C_RESET}"
else
  echo -e "${C_DIM}  📶 Bandwidth:    Limited to ${BW_LIMIT}${C_RESET}"
fi
if [[ $PRUNE -eq 1 ]]; then
  echo -e "${C_DIM}  ✂️  Prune Mode:   Enabled (Orphan cleanup active)${C_RESET}"
fi
if [[ $VERBOSE_MODE -eq 1 ]]; then
  echo -e "${C_DIM}  ⚙️  Rsync Engine: $RSYNC_ENGINE${C_RESET}"
  echo -e "${C_DIM}  📊 Dest Space:   $DST_FREE_STR free${C_RESET}"
fi
echo -e "${C_DIM}==============================================================${C_RESET}"
echo ""

# Export settings to environment for the Python progress monitor
export SAFESYNC_MODE="$MODE"
export SAFESYNC_DRY_RUN="$DRY_RUN"
export SAFESYNC_VERBOSE="$VERBOSE_MODE"
export SAFESYNC_SRC="$SRC"
export SAFESYNC_DST="$DST"
export SAFESYNC_PRUNE="$PRUNE"
export SAFESYNC_BW="$BW_LIMIT"
export SAFESYNC_READ_BW="${SAFESYNC_READ_BW:-150M}"
export SAFESYNC_VERSION="$VERSION"

# Verify python3 dependency (SEC-17)
if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: python3 is required to run SafeSync." >&2
  echo "Please install Xcode Command Line Tools: xcode-select --install" >&2
  exit 1
fi

# Auto-detect stdbuf availability for line-buffering (SEC-09)
STDBUF_CMD=()
if command -v stdbuf >/dev/null 2>&1; then
  STDBUF_CMD=(stdbuf -oL -eL)
fi

# Full-lifecycle sleep protection for both transfer & verification phases (SEC-19)
CAFFEINATE_PID=""
if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -dimsu -w $$ &
  CAFFEINATE_PID=$!
  trap 'if [[ -n "$CAFFEINATE_PID" ]]; then kill "$CAFFEINATE_PID" 2>/dev/null || true; fi' EXIT HUP INT TERM
fi

# Final TOCTOU mount verification right before starting transfer (SEC-05)
if [[ -n "$VOL" ]]; then
  DST_DEV=$(stat -f '%d' "$DST" 2>/dev/null || true)
  VOL_DEV=$(stat -f '%d' "$VOL" 2>/dev/null || true)
  if [[ -n "$VOL_DEV" && -n "$DST_DEV" && "$DST_DEV" != "$VOL_DEV" ]]; then
    echo "Error: Target volume '$VOL' was disconnected before transfer could start." >&2
    exit 1
  fi
fi


# Export additional settings
REPORT_DIR="${HOME}/Library/Logs/safesync"
export SAFESYNC_REPORT_DIR="$REPORT_DIR"
export SAFESYNC_RSYNC_ENGINE="$RSYNC_ENGINE"

# Locate safesync-engine.py (Option B: Decoupled Engine)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ENGINE_PATH=""
if [[ -f "${SCRIPT_DIR}/../libexec/safesync-engine.py" ]]; then
  ENGINE_PATH="${SCRIPT_DIR}/../libexec/safesync-engine.py"
elif [[ -f "${SCRIPT_DIR}/safesync-engine.py" ]]; then
  ENGINE_PATH="${SCRIPT_DIR}/safesync-engine.py"
elif [[ -f "${HOME}/.local/libexec/safesync-engine.py" ]]; then
  ENGINE_PATH="${HOME}/.local/libexec/safesync-engine.py"
elif [[ -f "${HOME}/.local/bin/safesync-engine.py" ]]; then
  ENGINE_PATH="${HOME}/.local/bin/safesync-engine.py"
fi

if [[ -z "$ENGINE_PATH" || ! -f "$ENGINE_PATH" ]]; then
  echo "Error: Cannot locate safesync-engine.py" >&2
  echo "Please ensure SafeSync is installed properly: ./install.sh" >&2
  exit 1
fi

if [[ "$MODE" == "full_audit" ]]; then
  python3 -u "$ENGINE_PATH" audit
  exit $?
else
  "${STDBUF_CMD[@]}" rsync "${RSYNC_FLAGS[@]}" "$SRC" "$DST" | python3 -u "$ENGINE_PATH" sync
  PIPE_STATUSES=("${PIPESTATUS[@]}")
  RSYNC_STATUS=${PIPE_STATUSES[0]}
  PYTHON_STATUS=${PIPE_STATUSES[1]}

  # Any rsync error, including vanished source files, makes this run incomplete.
  if [[ $RSYNC_STATUS -ne 0 ]]; then
    echo " [!] WARNING: rsync exited with status code $RSYNC_STATUS" >&2
    exit $RSYNC_STATUS
  fi

  # Propagate Python verification / monitor errors (e.g. hash mismatch or premature abort)
  if [[ $PYTHON_STATUS -ne 0 ]]; then
    exit $PYTHON_STATUS
  fi

  exit 0
fi
